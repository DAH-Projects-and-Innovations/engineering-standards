# Configuration of the example service (PY-021). Copy to .env; .env is ignored by Git.
# Every variable is optional: without QA_LLM_BASE_URL and QA_LLM_API_KEY the service runs offline.

# Maximum number of documents given to the model (1 to 10).
QA_MAX_DOCUMENTS=3

# OpenAI-compatible chat completions API, for example https://api.mistral.ai/v1
QA_LLM_BASE_URL=
# Secret: never commit a real value.
QA_LLM_API_KEY=
QA_LLM_MODEL=mistral-small-latest
QA_LLM_TIMEOUT_SECONDS=20
