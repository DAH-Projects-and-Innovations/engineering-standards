# DAH Labs .env.example template (rules FILE-015, PY-021).
# Copy to .env.example, list EVERY variable that the application reads, and commit it.
# Developers copy it to .env (ignored by Git) and fill in their own values.
# NEVER write a real key, password or token in this file.

# --- Application -----------------------------------------------------------------------------
# Prefix all variables with the project name to avoid conflicts (TODO: replace MYAPP).
MYAPP_ENV=development            # development | test | production
MYAPP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
MYAPP_CORS_ORIGINS=["http://localhost:3000"]

# --- Database --------------------------------------------------------------------------------
MYAPP_DATABASE_URL=postgresql+asyncpg://myapp:change-me@localhost:5432/myapp

# --- Language model providers (optional) -----------------------------------------------------
# Leave empty to use the local / free mode. Tests never need these values (PY-016).
MYAPP_LLM_PROVIDER=ollama        # ollama | openai | mistral
MYAPP_LLM_MODEL=mistral
MYAPP_OPENAI_API_KEY=
MYAPP_MISTRAL_API_KEY=

# --- Front end (public values only: they end up in the browser bundle, JS-009) ---------------
VITE_API_URL=http://localhost:8000
